FROM alpine@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507
RUN printf '%s\n' https://dl-cdn.alpinelinux.org/alpine/v3.21/main https://dl-cdn.alpinelinux.org/alpine/v3.21/community > /etc/apk/repositories \
    && apk add --no-cache iptables ip6tables iproute2 \
    && mkdir -p /run/open-compute \
    && chmod 0700 /run/open-compute
COPY container-sidecar /proxy-everything
COPY container-sidecar /opt/open-compute/exec/helper
ENTRYPOINT ["/proxy-everything"]
