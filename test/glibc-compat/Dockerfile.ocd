FROM rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS rust
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS bun
FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS node
FROM quay.io/pypa/manylinux_2_28_x86_64@sha256:1e7b8460ad8fb3fb0fbe1cd818845159ac896b4fd17452d56e892c291f3b97a8

ENV PATH=/usr/local/cargo/bin:/usr/local/bin:/opt/python/cp313-cp313/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN dnf install -y git git-lfs openssl-devel pkgconf-pkg-config perl-core libatomic \
    && dnf clean all \
    && python -m pip install --no-cache-dir cmake==3.31.6 ninja==1.13.0 pyelftools==0.33 \
    && git lfs install --system \
    && ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && test "$(getconf GNU_LIBC_VERSION)" = 'glibc 2.28' \
    && test "$(rustc --version | awk '{print $2}')" = 1.98.0 \
    && test "$(bun --version)" = 1.3.14 \
    && test "$(node --version)" = v26.8.1 \
    && npm --version \
    && npx --version
RUN curl -fL https://github.com/jdx/mr-boxington/releases/download/v1.22.0/mbx-x86_64-unknown-linux-musl.tar.gz -o /tmp/mbx.tar.gz \
    && echo 'c375135e2a3916f58da1b47537b6a954159eeacd55523d9a618b42259bd89014  /tmp/mbx.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/mbx.tar.gz -C /usr/local/bin mbx \
    && rm /tmp/mbx.tar.gz \
    && test "$(mbx --version)" = 'mbx 1.22.0' \
    && mbx settings set build_script_execution false \
    && mbx settings set target.views false \
    && mbx settings set restore_hardlink false \
    && mbx settings set gc.auto false \
    && mbx settings set gc.max_total_size 8GiB \
    && mbx settings set gc.min_free_size 4GiB
# Rust C++ build dependencies request -lstdc++; resolve that name only to the
# static toolset archive so the product does not require toolset-14 at runtime.
RUN mkdir /opt/static-cxx \
    && cp "$(g++ -print-file-name=libstdc++.a)" /opt/static-cxx/libstdc++.a
